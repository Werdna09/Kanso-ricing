# Raster files are ignored by default; only known Kanso wallpaper paths are allowed.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.avif
*.ico

# Only the curated artwork files named below may enter the public release.
!kanso/assets/kanso-wallpaper.png
!kanso/assets/kanso-wallpaper-night.png
!wallpaper/org.kanso.livinglandscape/contents/images/kanso-panorama.png
!wallpaper/org.kanso.livinglandscape/contents/images/kanso-panorama-night.png
!kanso/living-landscape/wallpapers/*.jpg
!kanso/living-landscape/wallpapers/*.jpeg
!kanso/living-landscape/wallpapers/*.png
!kanso/living-landscape/wallpapers/*.webp

# Build products and binary packages.
.build/
**/build/
**/bin/
*.o
*.a
*.so
*.exe
*.vsix
*.zip
*.tar
*.gz
*.7z
*.pdf

