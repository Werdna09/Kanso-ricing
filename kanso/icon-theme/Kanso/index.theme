[Icon Theme]
Name=Kanso
Comment=Minimal ink and washi application and file icons; falls back to Papirus/Breeze
Inherits=Papirus,breeze,hicolor
Directories=scalable/apps,scalable/places,scalable/mimetypes,scalable/devices,scalable/actions

[scalable/apps]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Applications

[scalable/places]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Places

[scalable/mimetypes]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=MimeTypes

[scalable/devices]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Devices

[scalable/actions]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Actions
