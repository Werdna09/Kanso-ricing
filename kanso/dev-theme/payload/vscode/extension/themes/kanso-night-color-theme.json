    "scrollbarSlider.hoverBackground": "#3C606BBB",
    "gitDecoration.addedResourceForeground": "#9FBEA5",
    "gitDecoration.modifiedResourceForeground": "#E4CCA3",
    "gitDecoration.deletedResourceForeground": "#D79B96",
    "diffEditor.insertedTextBackground": "#9FBEA525",
    "diffEditor.removedTextBackground": "#D79B9625",
    "minimap.background": "#12262E"
  },
  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#A3B7B2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string, string.quoted, string.template",
      "settings": {
        "foreground": "#9FBEA5"
      }
    },
    {
      "scope": "constant.numeric, constant.language.boolean",
      "settings": {
        "foreground": "#E4CCA3"
      }
    },
    {
      "scope": "keyword, storage.modifier, storage.type",
      "settings": {
        "foreground": "#D5CFAD"
      }
    },
    {
      "scope": "entity.name.function, support.function",
      "settings": {
        "foreground": "#99BEC9"
      }
    },
    {
      "scope": "entity.name.type, support.class, entity.name.class",
      "settings": {
        "foreground": "#8DC5BF"
      }
    },
    {
      "scope": "variable.parameter, meta.function.parameters",
      "settings": {
        "foreground": "#EADFCC"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#E4CCA3"
      }
    },
    {
      "scope": "invalid, invalid.illegal",
      "settings": {
        "foreground": "#D79B96"
      }
    },
    {
      "scope": "keyword.operator, punctuation",
      "settings": {
        "foreground": "#A3B7B2"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#99BEC9",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#EADFCC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#EADFCC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#9FBEA5"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#D79B96"
      }
    },
    {
      "scope": "support.type, entity.name.tag",
      "settings": {
        "foreground": "#8DC5BF"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#C6A9C6"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#99BEC9",
    "method": "#99BEC9",
    "class": "#8DC5BF",
    "type": "#8DC5BF",
    "interface": "#8DC5BF",
    "enum": "#E4CCA3",
    "variable": "#EADFCC",
    "parameter": "#EADFCC",
    "property": "#E4CCA3",
    "keyword": "#D5CFAD",
    "string": "#9FBEA5",
    "number": "#E4CCA3",
    "comment": "#A3B7B2",
    "namespace": "#C6A9C6",
    "typeParameter": "#8DC5BF",
    "variable.readonly": "#EADFCC",
    "*.deprecated": {
      "foreground": "#A3B7B2",
      "strikethrough": true
    }
  }
}
