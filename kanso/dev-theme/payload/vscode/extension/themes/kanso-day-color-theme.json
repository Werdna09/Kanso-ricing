  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#9EBCB8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string, string.quoted, string.template",
      "settings": {
        "foreground": "#A7C1A5"
      }
    },
    {
      "scope": "constant.numeric, constant.language.boolean",
      "settings": {
        "foreground": "#DDC99B"
      }
    },
    {
      "scope": "keyword, storage.modifier, storage.type",
      "settings": {
        "foreground": "#D5CFAD"
      }
    },
    {
      "scope": "entity.name.function, support.function",
      "settings": {
        "foreground": "#A5BCC8"
      }
    },
    {
      "scope": "entity.name.type, support.class, entity.name.class",
      "settings": {
        "foreground": "#92C3C1"
      }
    },
    {
      "scope": "variable.parameter, meta.function.parameters",
      "settings": {
        "foreground": "#F7E9C9"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#DDC99B"
      }
    },
    {
      "scope": "invalid, invalid.illegal",
      "settings": {
        "foreground": "#CF958B"
      }
    },
    {
      "scope": "keyword.operator, punctuation",
      "settings": {
        "foreground": "#9EBCB8"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#A5BCC8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#F7E9C9",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#F7E9C9",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#A7C1A5"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#CF958B"
      }
    },
    {
      "scope": "support.type, entity.name.tag",
      "settings": {
        "foreground": "#92C3C1"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#C7B3CA"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#A5BCC8",
    "method": "#A5BCC8",
    "class": "#92C3C1",
    "type": "#92C3C1",
    "interface": "#92C3C1",
    "enum": "#DDC99B",
    "variable": "#F7E9C9",
    "parameter": "#F7E9C9",
    "property": "#DDC99B",
    "keyword": "#D5CFAD",
    "string": "#A7C1A5",
    "number": "#DDC99B",
    "comment": "#9EBCB8",
    "namespace": "#C7B3CA",
    "typeParameter": "#92C3C1",
    "variable.readonly": "#F7E9C9",
    "*.deprecated": {
      "foreground": "#9EBCB8",
      "strikethrough": true
    }
  }
}
